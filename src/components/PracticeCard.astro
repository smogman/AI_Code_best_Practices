---
import ConfidenceRating from './ConfidenceRating.astro';

interface Props {
  title: string;
  category: 'consensus' | 'contested' | 'advanced' | 'failure-mode';
  confidence: 1 | 2 | 3 | 4 | 5;
  summary: string;
  tags: string[];
  sourceCount: number;
}

const { title, category, confidence, summary, tags, sourceCount } = Astro.props;

const categoryConfig: Record<string, { label: string; color: string; bg: string; border: string }> = {
  consensus: { label: 'Consensus', color: '#166534', bg: '#dcfce7', border: '#86efac' },
  contested: { label: 'Contested', color: '#92400e', bg: '#fef3c7', border: '#fcd34d' },
  advanced: { label: 'Advanced', color: '#1e3a5f', bg: '#dbeafe', border: '#93c5fd' },
  'failure-mode': { label: 'Pitfall', color: '#991b1b', bg: '#fee2e2', border: '#fca5a5' },
};

const cat = categoryConfig[category];
---

<div class="practice-card" style={`border-left-color: ${cat.border}`}>
  <div class="practice-header">
    <span class="practice-category" style={`color: ${cat.color}; background-color: ${cat.bg}`}>
      {cat.label}
    </span>
    <ConfidenceRating level={confidence} />
  </div>
  <h3 class="practice-title">{title}</h3>
  <p class="practice-summary">{summary}</p>
  <div class="practice-footer">
    <div class="practice-tags">
      {tags.map((tag) => (
        <span class="practice-tag">{tag}</span>
      ))}
    </div>
    <span class="practice-sources">{sourceCount} source{sourceCount !== 1 ? 's' : ''}</span>
  </div>
</div>

<style>
  .practice-card {
    border: 1px solid var(--sl-color-gray-5);
    border-left-width: 4px;
    border-radius: 8px;
    padding: 1.25rem;
    margin: 0.75rem 0;
    transition: box-shadow 0.2s;
  }
  .practice-card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .practice-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .practice-category {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .practice-title {
    margin: 0.5rem 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .practice-summary {
    margin: 0.5rem 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }
  .practice-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.75rem;
  }
  .practice-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .practice-tag {
    display: inline-block;
    padding: 1px 8px;
    border-radius: 4px;
    font-size: 0.7rem;
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-gray-3);
  }
  .practice-sources {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
</style>
